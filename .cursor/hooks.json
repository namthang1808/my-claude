{
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "node \".cursor/hooks/secret-output-guardrail.cjs\"",
        "type": "command"
      },
      {
        "command": "node \".cursor/hooks/simplify-gate.cjs\"",
        "type": "command"
      },
      {
        "command": "node \".cursor/hooks/session-heartbeat.cjs\"",
        "type": "command"
      },
      {
        "command": "node \".cursor/hooks/secret-output-guardrail.cjs\"",
        "type": "command"
      },
      {
        "command": "node \".cursor/hooks/dev-rules-reminder.cjs\"",
        "type": "command"
      },
      {
        "command": "node \".cursor/hooks/simplify-gate.cjs\"",
        "type": "command"
      },
      {
        "command": "node \".cursor/hooks/usage-quota-cache-refresh.cjs\"",
        "type": "command"
      },
      {
        "command": "node \".cursor/hooks/session-heartbeat.cjs\"",
        "type": "command"
      }
    ],
    "postToolUse": [
